{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .github/hooks/session-start.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github\\hooks\\session-start.ps1",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .github/hooks/pre-tool-use.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github\\hooks\\pre-tool-use.ps1",
        "cwd": ".",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .github/hooks/post-tool-use.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github\\hooks\\post-tool-use.ps1",
        "cwd": ".",
        "timeout": 15
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .github/hooks/post-tool-use.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github\\hooks\\post-tool-use.ps1",
        "cwd": ".",
        "timeout": 15
      }
    ]
  }
}